# L1 运维环境变量模板 —— 复制为 .env_l1 并填入真实凭据
# 真实凭据见 wiki 量化开发/运维/L1凭据.md (NAS 同步可见)
# 用法: cp .env_l1.example .env_l1 && 填入密码
export L1_PG_DSN="host=100.76.208.125 port=5432 user=postgres password=<PG密码> dbname=quant connect_timeout=20 keepalives=1 keepalives_idle=30 keepalives_interval=10 keepalives_count=6"
export QUANT_PG_PASSWORD=<PG密码>
export AD_USERNAME=<星耀账号>
export AD_PASSWORD=<星耀密码>
export AD_HOST=101.230.159.235
export AD_PORT=8600
